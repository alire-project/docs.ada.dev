{"schema_version":"1","crate":"swiss_micros_tools","version":"1.8.12","id":"134f5ca882dfedda","name":"Swiss_Micros.Command_Line","qualified_name":"Swiss_Micros.Command_Line","kind":"ada_package","location":{"file":"src/swiss_micros-command_line.ads","line":42,"column":9},"code":"package Swiss_Micros.Command_Line","documentation":{"description":"-\n  @summary\n  Shared command-line parser for every Swiss Micros tool.\n\n  @description\n  Tagged extension of `AdaCL.Command_Line.GetOpt.Object` that understands the one option every tool needs: which USB\n  serial device to open.\n\n  GetOpt is re-entrant *and* hierarchical. A concrete tool derives its own options type from\n  `Swiss_Micros.Command_Line.Object`, adds only the flags that are unique to that tool, and forwards every\n  other token to `Super`. Device handling, `-?` / `--help`, and the `DM_SERIAL_DEVICE` fallback then come for free.\n\n  Do not instantiate this type from a main programme. Derive from it."},"tagged_types":[{"id":"8f899cd6f407f101","name":"Object","qualified_name":"Swiss_Micros.Command_Line.Object","kind":"ada_tagged_type","location":{"file":"src/swiss_micros-command_line.ads","line":50,"column":9},"code":"type Object is new AdaCL.Command_Line.GetOpt.Object with private;","parent_type":{"qualified_name":"AdaCL.Command_Line.GetOpt.Object","id":"a6224027e4e2a2e3","unit":"adacl-command_line-getopt"},"derived_types":[{"qualified_name":"DM_Receive.Command_Line.Object","id":"6326fe6acf6675ce","unit":"dm_receive-command_line"},{"qualified_name":"DM_Set_Time.Command_Line.Object","id":"98545e6d0921ee93","unit":"dm_set_time-command_line"}],"dispatching_declared":[{"qualified_name":"Swiss_Micros.Command_Line.Device","id":"e668f2eb067e8172","unit":"swiss_micros-command_line"}],"dispatching_overridden":[{"qualified_name":"Swiss_Micros.Command_Line.Analyze_GNU","id":"2a38dab0ea60c47c","unit":"swiss_micros-command_line"},{"qualified_name":"Swiss_Micros.Command_Line.Analyze_With_Argument","id":"0b5f6fc84b57591