{"schema_version":"1","crate":"sparrow_crypto","version":"1.0.0","id":"83cfcd80da434e47","name":"Sparrow.Crypto.Ciphers","qualified_name":"Sparrow.Crypto.Ciphers","kind":"ada_package","location":{"file":"src/sparrow-crypto-ciphers.ads","line":6,"column":9},"code":"package Sparrow.Crypto.Ciphers","documentation":{"description":"Authenticated encryption: AES-256-GCM and ChaCha20-Poly1305, each with a 32-byte key, a 12-byte nonce and a\n16-byte tag.\n\nA nonce must never repeat under one key. Draw it with Sparrow.Crypto.Random.Fill and store it beside the\nsealed text; with random nonces, rotate a key before it has sealed about 2 ** 32 messages."},"simple_types":[{"id":"23322945eb5220c1","name":"Aead_Algorithm","qualified_name":"Sparrow.Crypto.Ciphers.Aead_Algorithm","kind":"ada_simple_type","location":{"file":"src/sparrow-crypto-ciphers.ads","line":8,"column":9},"code":"type Aead_Algorithm is (Aes_256_Gcm, Chacha20_Poly1305);"}],"subtypes":[{"id":"08b37d2bfbf1c280","name":"Key_Bytes","qualified_name":"Sparrow.Crypto.Ciphers.Key_Bytes","kind":"ada_subtype","location":{"file":"src/sparrow-crypto-ciphers.ads","line":10,"column":12},"code":"subtype Key_Bytes is String (1 .. 32);"},{"id":"3ccaacfe9b1460c7","name":"Nonce_Bytes","qualified_name":"Sparrow.Crypto.Ciphers.Nonce_Bytes","kind":"ada_subtype","location":{"file":"src/sparrow-crypto-ciphers.ads","line":11,"column":12},"code":"subtype Nonce_Bytes is String (1 .. 12);"}],"constants":[{"id":"2f379402887820fd","name":"Max_Length","qualified_name":"Sparrow.Crypto.Ciphers.Max_Length","kind":"ada_constant","location":{"file":"src/sparrow-crypto-ciphers.ads","line":13,"column":4},"code":"Max_Length : constant := 2 ** 30;"},{"id":"406ec5c44260af0c","name":"Tag_Length","qualified_name":"Sparrow.Crypto.Ciphers.Tag_Length","kind":"ada_constant","location":{"file":"src/sparrow-crypto-ciphers.ads","line":12,"column":4},"code":"Tag_Length : constant := 16;"}],"subprograms":[{"id":"a9d73520e1b9ea47","name":"Open","qualified_name":"Sparrow.Crypto.Ciphers.Open","kind":"ada_procedure","location":{"file":"src/sparrow-crypto-ciphers.ads","line":27,"column":14},"code":"procedure Open\n  (Algorithm  : Aead_Algorithm;\n   Key        : Key_Bytes;\n   Nonce      : Nonce_Bytes;\n   Sealed     : String;\n   Plain      : out String;\n   Last       : out Natural;\n   Valid      : out Boolean;\n   Associated : String := \"\")"},{"id":"b9c090e8414cc042","name":"Seal","qualified_name":"Sparrow.Crypto.Ciphers.Seal","kind":"ada_function","location":{"file":"src/sparrow-crypto-ciphers.ads","line":16,"column":13},"code":"function Seal\n  (Algorithm  : Aead_Algorithm;\n   Key        : Key_Bytes;\n   Nonce      : Nonce_Bytes;\n   Plain      : String;\n   Associated : String := \"\") return String"}]}