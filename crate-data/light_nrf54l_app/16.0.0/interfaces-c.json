ada_simple_type","location":{"file":"gnat/i-c.ads","line":69,"column":9},"code":"type long_long is new Long_Long_Integer;"},{"id":"f17fa7c20bd995c8","name":"ptrdiff_t","qualified_name":"Interfaces.C.ptrdiff_t","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":92,"column":9},"code":"type ptrdiff_t is\n  range -System.Memory_Size / 2 .. System.Memory_Size / 2 - 1;"},{"id":"33267bf2d9d8c42a","name":"short","qualified_name":"Interfaces.C.short","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":66,"column":9},"code":"type short is new Short_Integer;"},{"id":"5742096935d36d66","name":"signed_char","qualified_name":"Interfaces.C.signed_char","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":71,"column":9},"code":"type signed_char is range SCHAR_MIN .. SCHAR_MAX;"},{"id":"a45bee8a5a4db565","name":"size_t","qualified_name":"Interfaces.C.size_t","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":95,"column":9},"code":"type size_t is mod System.Memory_Size;"},{"id":"d4b23f0f049579ff","name":"unsigned","qualified_name":"Interfaces.C.unsigned","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":74,"column":9},"code":"type unsigned           is mod 2 ** int'Size;"},{"id":"5fe8ae1c3ec0e9ad","name":"unsigned_char","qualified_name":"Interfaces.C.unsigned_char","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":79,"column":9},"code":"type unsigned_char is mod (UCHAR_MAX + 1);"},{"id":"605c1f0e82b67b6b","name":"unsigned_long","qualified_name":"Interfaces.C.unsigned_long","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":76,"column":9},"code":"type unsigned_long      is mod 2 ** long'Size;"},{"id":"5ee15a5c6aeff895","name":"unsigned_long_long","qualified_name":"Interfaces.C.unsigned_long_long","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":77,"column":9},"code":"type unsigned_long_long is mod 2 ** long_long'Size;"},{"id":"22e0369b1eaade63","name":"unsigned_short","qualified_name":"Interfaces.C.unsigned_short","kind":"ada_simple_type","location":{"file":"gnat/i-c.ads","line":75,"column":9},"code":"type unsigned_short     is mod 2 ** short'Size;"}],"array_types":[{"id":"606749bc9165c3ef","name":"char_array","qualified_name":"Interfaces.C.char_array","kind":"ada_array_type","location":{"file":"gnat/i-c.ads","line":127,"column":9},"code":"type char_array is array (size_t range <>) of aliased char;"}],"subtypes":[{"id":"e0369fc145b22be7","name":"plain_char","qualified_name":"Interfaces.C.plain_char","kind":"ada_subtype","location":{"file":"gnat/i-c.ads","line":86,"column":12},"code":"subtype plain_char is unsigned_char;"}],"constants":[{"id":"8164cda4ba4c2792","name":"CHAR_BIT","qualified_name":"Interfaces.C.CHAR_BIT","kind":"ada_constant","location":{"file":"gnat/i-c.ads","line":53,"column":4},"code":"CHAR_BIT  : constant := 8;"},{"id":"472dba95cc28f57e","name":"nul","qualified_name":"Interfaces.C.nul","kind":"ada_constant","location":{"file":"gnat/i-c.ads","line":114,"column":4},"code":"nul : constant char := char'First;"},{"id":"fd17443f150870ab","name":"SCHAR_MAX","qualified_name":"Interfaces.C.SCHAR_MAX","kind":"ada_constant","location":{"file":"gnat/i-c.ads","line":55,"column":4},"code":"SCHAR_MAX : constant := 127;"},{"id":"1f07a4a75185dc99","name":"SCHAR_MIN","qualified_name":"Interfaces.C.SCHAR_MIN","kind":"ada_constant","location":{"file":"gnat/i-c.ads","line":54,"column":4},"code":"SCHAR_MIN : constant := -128;"},{"id":"7234d2634b1421f1","name":"UCHAR_MAX","qualified_name":"Interfaces.C.UCHAR_MAX","kind":"ada_constant","location":{"file":"gnat/i-c.ads","line":56,"column":4},"code":"UCHAR_MAX : constant := 255;"}],"exceptions":[{"id":"0934c0d31ccd1e2e","name":"Terminator_Error","qualified_name":"Interfaces.C.Terminator_Error","kind":"ada_exception","location":{"file":"gnat/i-c.ads","line":245,"column":4},"code":"Terminator_Error : exception;"}],"subprograms":[{"id":"4318a9f88f62dd54","name":"C_Length_Ghost","qualified_name":"Interfaces.C.C_Length_Ghost","kind":"ada_function","location":{"file":"gnat/i-c.ads","line":136,"column":13},"code":"function C_Length_Ghost (Item : char_array) return size_t","documentation":{"description":"Ghost function to compute the length of a char_array up to the first nul\ncharacter.","parameters":[{"name":"Item","description":""}]}},{"id":"203fd7ebb06d32a1","name":"Is_Nul_Terminated","qualified_name":"Interfaces.C.Is_Nul_Terminated","kind":"ada_function","location":{"file":"gnat/i-c.ads","line":130,"column":13},"code":"function Is_Nul_Terminated (Item : char_array) return Boolean","documentation":{"description":"The result of Is_Nul_Terminated is True if Item contains nul, and is\nFalse otherwise.","parameters":[{"name":"Item","description":""}]}},{"id":"ff983cd520ddb2ea","name":"To_Ada","qualified_name":"Interfaces.C.To_Ada","kind":"ada_function","location":{"file":"gnat/i-c.ads","line":123,"column":13},"code":"function To_Ada (Item : char) return Character"},{"id":"31576d403e1a4f9c","name":"To_Ada","qualified_name":"Interfaces.C.To_Ada","kind":"ada_function","location":{"file":"gnat/i-c.ads","line":167,"column":13},"code":"function To_Ada\n  (Item     : char_array;\n   Trim_Nul : Boolean := True) return String","documentation":{"description":"The result of To_Ada is a String whose length is Item'Length (if\nTrim_Nul is False) or the length of the slice of Item preceding the\nfirst nul (if Trim_Nul is True). The lower bound of the result is 1.\nIf Trim_Nul is False, then for each component Item(I) the corresponding\ncomponent in the result is To_Ada applied to Item(I). If Trim_Nul\nis True, then for each component Item(I) before the first nul the\ncorresponding component in the result is To_Ada applied to Item(I). The\nfunction propagates Terminator_Error if Trim_Nul is True and Item does\nnot contain nul.","parameters":[{"name":"Item","description":""},{"name":"Trim_Nul","description":""}]}},{"id":"3e51e829b145d676","name":"To_Ada","qualified_name":"Interfaces.C.To_Ada","kind":"ada_procedure","location":{"file":"gnat/i-c.ads","line":216,"column":14},"code":"procedure To_Ada\n  (Item     : char_array;\n   Target   : out String;\n   Count    : out Natural;\n   Trim_Nul : Boolean := True)","documentation":{"description":"For procedure To_Ada, each element of Item (if Trim_Nul is False) or\neach element of Item preceding the first nul (if Trim_Nul is True) is\nconverted (via the To_Ada function) to a Character, which is assigned\nto the corresponding element of Target. Count is set to the number of\nTarget elements assigned. If Target is not long enough, Constraint_Error\nis propagated. If Trim_Nul is True and Item does not contain nul, then\nTerminator_Error is propagated.","parameters":[{"name":"Item","description":""},{"name":"Target","description":""},{"name":"Count","description":""},{"name":"Trim_Nul","description":""}]}},{"id":"336e1250b8d2595a","name":"To_C","qualified_name":"Interfaces.C.To_C","kind":"ada_function","location":{"file":"gnat/i-c.ads","line":119,"column":13},"code":"function To_C (Item : Character) return char"},{"id":"06ea23a82368804e","name":"To_C","qualified_name":"Interfaces.C.To_C","kind":"ada_function","location":{"file":"gnat/i-c.ads","line":149,"column":13},"code":"function To_C\n  (Item       : String;\n   Append_Nul : Boolean := True) return char_array","documentation":{"description":"The result of To_C is a char_array value of length Item'Length (if\nAppend_Nul is False) or Item'Length+1 (if Append_Nul is True). The lower\nbound is 0. For each component Item(I), the corresponding component\nin the result is To_C applied to Item(I). The value nul is appended if\nAppend_Nul is True. If Append_Nul is False and Item'Length is 0, then\nTo_C propagates Constraint_Error.","parameters":[{"name":"Item","description":""},{"name":"Append_Nul","description":""}]}},{"id":"81293cce64624ff4","name":"To_C","qualified_name":"Interfaces.C.To_C","kind":"ada_procedure","location":{"file":"gnat/i-c.ads","line":192,"column":14},"code":"procedure To_C\n  (Item       : String;\n   Target     : out char_array;\n   Count      : out size_t;\n   Append_Nul : Boolean := True)","documentation":{"description":"For procedure To_C, each element of Item is converted (via the To_C\nfunction) to a char, which is assigned to the corresponding element of\nTarget. If Append_Nul is True, nul is then assigned to the next element\nof Target. In either case, Count is set to the number of Target elements\nassigned. If Target is not long enough, Constraint_Error is propagated.","parameters":[{"name":"Item","description":""},{"name":"Target","description":""},{"name":"Count","description":""},{"name":"Append_Nul","description":""}]}}]}